@startuml
!pragma layout elk
title Tabiora - Manager Use Cases
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam defaultFontColor #111111
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #222222
skinparam ArrowColor #222222

left to right direction
actor Manager
rectangle "Tabiora - Manager" {
 usecase "View / manage reservations" as Reservations
 usecase "View / manage incoming pre-orders" as Orders
 usecase "Request table-availability change" as Availability
 usecase "Request menu-information change" as Menu
}
Reservations -[hidden]down-> Orders
Orders -[hidden]down-> Availability
Availability -[hidden]down-> Menu

Reservations -- Manager
Orders -- Manager
Availability -- Manager
Menu -- Manager
@enduml
