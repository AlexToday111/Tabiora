@startuml
!pragma layout elk
title Tabiora - Customer Discovery and Booking
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam defaultFontColor #111111
skinparam packageStyle rectangle
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #222222
skinparam ArrowColor #222222
left to right direction

actor Customer
rectangle "Tabiora - Customer App" {
 package "Discovery" {
  usecase "Search restaurants\nFR-001" as Search
  usecase "Filter restaurants\nFR-002" as Filter
  usecase "View restaurant details\nFR-003" as Details
  usecase "View menu\nFR-006" as Menu
 }
 package "Booking" {
  usecase "View timed table\navailability\nFR-004" as Availability
  usecase "Reserve a table\nFR-005" as Book
  usecase "Check booking conflict\nat confirmation\nFR-005, NFR-004" as Conflict
 }
}

Search -- Customer
Details -- Customer
Menu -- Customer
Availability -- Customer
Book -- Customer
Search <.. Filter : <<extend>>\n[filters selected]
Book ..> Conflict : <<include>>

@enduml
