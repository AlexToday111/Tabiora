@startuml
!pragma layout elk
title Tabiora - Ordering and Payment
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #E3EFFA
skinparam classBorderColor #344455
skinparam packageStyle rectangle
hide empty members
hide circle

top to bottom direction
class Reservation {
 reservationId: Identifier
 status: ReservationStatus
}
class Restaurant {
 restaurantId: Identifier
}
class Menu {
 menuId: Identifier
}
class MenuItem {
 itemId: Identifier
 price: Decimal
 isAvailable: Boolean
}
class PreOrder {
 orderId: Identifier
 readyAt: DateTime
 checkoutDeadline: DateTime
 quotedAmount: Decimal
 currency: String
 status: PreOrderStatus
 deliveryStatus: DeliveryStatus
 +addItem(itemId, quantity, unitPrice)
 +calculateTotal(): Decimal
}
class OrderItem {
 quantity: Integer
 unitPrice: Decimal
}
class Payment {
 attemptId: Identifier
 providerReference: String
 amount: Decimal
 currency: String
 status: PaymentStatus
 +applyVerifiedResult(result)
 +markUnknown()
}
enum PreOrderStatus <<enumeration>> #FFF0D2 {
 DRAFT
 AWAITING_PAYMENT
 PAID
 CANCELLED
 EXPIRED
 REVIEW_REQUIRED
}
enum PaymentStatus <<enumeration>> #FFF0D2 {
 INITIATED
 SUCCEEDED
 FAILED
 UNKNOWN
}
enum DeliveryStatus <<enumeration>> #FFF0D2 {
 PENDING
 DELIVERED
 FAILED
}
class OrderService <<application service>> #E1F2E7 {
 +createPreOrder(reservationId, readyAt)
 +addItem(orderId, itemId, quantity)
 +quote(orderId)
 +markAwaitingPayment(orderId)
 +acceptPaidOrder(orderId, attemptId): FulfilmentDecision
 +cancelUnpaid(orderId)
 +expireUnpaid(orderId)
 +reviewUnresolved(orderId)
 +recordDelivery(reference, result)
}
class PaymentService <<application service>> #E1F2E7 {
 +initiatePayment(orderId)
 +handleProviderResult(event)
 +markUnknown(attemptId)
 +reconcilePayment(attemptId)
}
interface PaymentProviderPort <<interface>> #EFE8FA {
 +initiate(attemptId, amount, currency): ProviderResult
 +verifyResult(event): ProviderResult
 +queryStatus(attemptId): ProviderResult
}
interface POSIntegration <<interface>> #EFE8FA {
 +deliverConfirmed(reference): DeliveryResult
}
Reservation "1" -- "0..1" PreOrder : P-PAY
Restaurant "1" -- "1" Menu : offers
Menu "1" -- "0..*" MenuItem
PreOrder "1" *-- "0..*" OrderItem
OrderItem "0..*" -- "1" MenuItem
PreOrder "1" -- "0..*" Payment : attempts
OrderService ..> PreOrder
OrderService ..> POSIntegration
PaymentService ..> Payment
PaymentService ..> PaymentProviderPort
PaymentService ..> OrderService : verified success
PreOrder ..> PreOrderStatus
Payment ..> PaymentStatus
PreOrder ..> DeliveryStatus
@enduml
