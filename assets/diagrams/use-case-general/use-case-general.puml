@startuml
!pragma layout elk
title Tabiora - General Use Cases
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam defaultFontColor #111111
skinparam packageStyle rectangle
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #222222
skinparam ArrowColor #222222
left to right direction

actor Customer
actor Waiter
actor Manager
actor "Payment Provider" as Provider
actor "Restaurant/POS" as POS

rectangle "Tabiora" {
 package "Customer App" {
  usecase "Search restaurants\nFR-001" as Search
  usecase "Filter restaurants\nFR-002" as Filter
  usecase "Reserve a table\nFR-005" as Book
  usecase "Check booking conflict\nFR-005, NFR-004" as Conflict
  usecase "Create a pre-order\nFR-007" as Order
  usecase "Prepay a pre-order\nFR-008" as Prepay
  usecase "Pay restaurant bill\nFR-011" as Bill
  usecase "Call a waiter\nFR-010" as Call
  usecase "Pay by phone" as PhonePayment
 }
 package "Staff Interface" {
  usecase "Receive waiter-call\nnotification\nFR-014" as Notify
  usecase "Manage reservations\nFR-012" as ManageBookings
  usecase "Manage pre-orders\nFR-013" as ManageOrders
 }
 package "Restaurant Integration" {
  usecase "Deliver confirmed\nreservation / pre-order\nFR-009" as Handoff
 }
}

Search -[hidden]down-> Book
Book -[hidden]down-> Order
Order -[hidden]down-> Prepay
Prepay -[hidden]down-> Bill
Bill -[hidden]down-> Call
Notify -[hidden]down-> ManageBookings
ManageBookings -[hidden]down-> ManageOrders

Search -- Customer
Book -- Customer
Order -- Customer
Prepay -- Customer
Bill -- Customer
Call -- Customer
Search <.. Filter : <<extend>>\n[filters selected]
Book ..> Conflict : <<include>>
Prepay --|> PhonePayment
Bill --|> PhonePayment
Prepay -- Provider
Bill -- Provider
Notify -- Waiter
ManageBookings -- Manager
ManageOrders -- Manager
Handoff -- POS

@enduml
