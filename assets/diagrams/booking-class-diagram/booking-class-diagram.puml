@startuml
!pragma layout smetana
title Tabiora - Booking and Reservation
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #E3EFFA
skinparam classBorderColor #344455
skinparam packageStyle rectangle
hide empty members
hide circle

top to bottom direction
class Customer {
 userId: Identifier
}
class Restaurant {
 restaurantId: Identifier
}
class FloorPlan {
 planId: Identifier
}
class RestaurantTable {
 tableId: Identifier
 capacity: Integer
}
class Reservation {
 reservationId: Identifier
 start: DateTime
 end: DateTime
 guestCount: Integer
 status: ReservationStatus
 deliveryStatus: DeliveryStatus
}
enum DeliveryStatus <<enumeration>> #FFF0D2 {
 PENDING
 DELIVERED
 FAILED
}
enum ReservationStatus <<enumeration>> #FFF0D2 {
 CONFIRMED
 CANCELLED
 EXPIRED
}
class BookingService <<application service>> #E1F2E7 {
 +checkAvailability(tableId, start, end, guestCount): AvailabilityResult
 +createBooking(customerId, tableId, start, end, guestCount): BookingResult
 +changeReservation(reservationId, newStart, newEnd): BookingResult
 +cancelReservation(reservationId)
 +expireReservation(reservationId)
 +recordDelivery(reference, result)
}
interface BookingAuthority <<interface>> #EFE8FA {
 +checkAvailability(tableId, start, end, guestCount): AvailabilityResult
 +createIfAvailable(customerId, tableId, start, end, guestCount): BookingResult
 +changeIfAvailable(reservationId, newStart, newEnd): BookingResult
}
interface POSIntegration <<interface>> #EFE8FA {
 +deliverConfirmed(reference): DeliveryResult
}
Customer "1" -- "0..*" Reservation
Restaurant "1" -- "1" FloorPlan
FloorPlan "1" -- "1..*" RestaurantTable : displays
RestaurantTable "1" -- "0..*" Reservation
BookingService ..> BookingAuthority : delegates atomic decision
BookingService ..> Reservation : coordinates
BookingService ..> POSIntegration : confirmed handoff
Reservation ..> ReservationStatus
Reservation ..> DeliveryStatus
@enduml
