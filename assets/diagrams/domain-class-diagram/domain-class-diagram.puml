@startuml
!pragma layout elk
title Tabiora - General Domain Model
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #E3EFFA
skinparam classBorderColor #344455
skinparam packageStyle rectangle
hide empty members
hide circle

left to right direction
skinparam nodesep 22
skinparam ranksep 30
class Customer
class Restaurant
class RestaurantTable
class MenuItem
class Reservation
class PreOrder
class OrderItem
class Payment
class WaiterCall
class ActivityLog
class PreferenceProfile
class Recommendation
Restaurant "1" -- "1..*" RestaurantTable
Customer -- Reservation
RestaurantTable -- Reservation
Reservation "1" -- "0..1" PreOrder
PreOrder *-- "0..*" OrderItem
OrderItem "0..*" -- "1" MenuItem
PreOrder -- "0..*" Payment
Customer -- WaiterCall
RestaurantTable -- WaiterCall
Customer -- ActivityLog
Customer -- PreferenceProfile
PreferenceProfile "1" -- "0..*" Recommendation
Recommendation ..> ActivityLog
@enduml
