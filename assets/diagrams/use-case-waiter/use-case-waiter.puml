@startuml
!pragma layout elk
title Tabiora - Waiter Use Cases
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam defaultFontColor #111111
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #222222
skinparam ArrowColor #222222

left to right direction
actor Waiter
rectangle "Tabiora - Waiter" {
 usecase "Receive waiter-call notification" as Receive
 usecase "Acknowledge a call" as Ack
 usecase "Resolve a call" as Resolve
 usecase "View relevant pre-orders" as Orders
}
Receive -[hidden]down-> Ack
Ack -[hidden]down-> Resolve
Resolve -[hidden]down-> Orders

Receive -- Waiter
Ack -- Waiter
Resolve -- Waiter
Orders -- Waiter
@enduml
